# Copy to .env.local (or .env) for local development. Never commit real values.
# Points at the ingestion/inference gateway - the VPS through the ssh tunnel while
# testing, or a real hostname once one exists (docs/06 D6).
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# The "app" agent token from the VPS's backend/.env AGENT_TOKENS list.
EXPO_PUBLIC_AGENT_TOKEN=
