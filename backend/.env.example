# Copy to .env and fill in. Never commit .env.
APP_ENV=development

# Postgres (matches docker-compose.yml)
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://ghostagent:${POSTGRES_PASSWORD}@postgres:5432/ghostagent

REDIS_URL=redis://redis:6379/0

# Object storage. Contabo S3 in production; the dev overlay sets MinIO values itself.
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=ghostagent
S3_REGION=us-east-1

# Per-agent bearer tokens: agent_id:token, comma separated. Generate a token with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_TOKENS=

MAX_UPLOAD_BYTES=536870912

# Creative director. Leave empty to run with the heuristic planner.
ANTHROPIC_API_KEY=
DIRECTOR_MODEL=claude-opus-5
DIRECTOR_EFFORT=high

# Free alternative: a local model server (Ollama) on the Legion, reached through
# the same tunnel/Tailscale link as the render endpoint. Tried after Claude (if
# configured), before the heuristic planner. This is the recommended path when
# there is no Anthropic budget.
LOCAL_DIRECTOR_URL=
LOCAL_DIRECTOR_MODEL=qwen2.5:7b-instruct

# Chat (docs/06 D22). The conversational turn on the chat screen reads a message,
# picks one action, and writes the reply - same backend ladder as the director, but a
# different model and a cheaper effort level, because it runs on every message someone
# sends. Measure a candidate with tools/chat_route_eval.py before changing CHAT_MODEL:
# on the bundled set qwen3:8b routes 15/15 and qwen2.5:7b-instruct 6/15.
CHAT_MODEL=qwen3:8b
CHAT_EFFORT=low
# Ollama unloads an idle model; without this every turn pays a cold load (~8s here).
CHAT_KEEP_ALIVE=10m
CHAT_TIMEOUT_S=90
CHAT_HISTORY_TURNS=8
CHAT_MAX_JOBS_PER_THREAD=40

# SDXL render quality. Base+refiner is the official two-stage SDXL 1.0 pipeline - free,
# no extra data needed. Leave SDXL_REFINER_CHECKPOINT empty until it's downloaded onto
# the render machine; the graph falls back to a single-stage render.
SDXL_STEPS=30
SDXL_BASE_CHECKPOINT=sd_xl_base_1.0.safetensors
SDXL_REFINER_CHECKPOINT=
SDXL_REFINER_SWITCH=0.8

# ComfyUI endpoints: the Legion through the tunnel (or Tailscale), and a burst GPU box.
LEGION_INFERENCE_URL=
BURST_INFERENCE_URL=
INFERENCE_TIMEOUT_S=240
CORS_ORIGINS=*

# MinIO on the VPS (docker-compose.vps.yml only)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
