# Copy to .env and fill in. Never commit .env.
APP_ENV=development

# Postgres (matches docker-compose.yml)
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://ghostagent:${POSTGRES_PASSWORD}@postgres:5432/ghostagent

REDIS_URL=redis://redis:6379/0

# Object storage. Contabo S3 in production; the dev overlay sets MinIO values itself.
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=ghostagent
S3_REGION=us-east-1

# Per-agent bearer tokens: agent_id:token, comma separated. Generate a token with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_TOKENS=

MAX_UPLOAD_BYTES=536870912

# Creative director. Leave empty to run with the heuristic planner.
ANTHROPIC_API_KEY=
DIRECTOR_MODEL=claude-opus-5
DIRECTOR_EFFORT=high

# ComfyUI endpoints: the Legion through the tunnel (or Tailscale), and a burst GPU box.
LEGION_INFERENCE_URL=
BURST_INFERENCE_URL=
INFERENCE_TIMEOUT_S=240
CORS_ORIGINS=*

# MinIO on the VPS (docker-compose.vps.yml only)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
